{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "@types/node"]
  },
  "include": ["tests/**/*", "support/**/*", "support/types/**/*", "playwright.config.ts", "eslint.config.ts", "orval.config.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "sprint5"]
}